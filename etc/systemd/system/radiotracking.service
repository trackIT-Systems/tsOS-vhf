[Unit]
Description=Detect signals of wildlife tracking transmitters with RTL SDR devices
After=network.target mosquitto.service time-sync.target hostname-config.service
Requires=time-sync.target
RequiresMountsFor=/boot/firmware /data
ConditionPathExists=/boot/firmware/radiotracking.ini

# Reboot after more than 10 restarts in 15 minutes happened.
# This will happen after 10 minutes at the earliest, according to service configuration.
StartLimitBurst=10
StartLimitIntervalSec=900s
StartLimitAction=reboot

[Service]
Nice=-10
ExecStart=radiotracking --config /boot/firmware/radiotracking.ini --station %H --dashboard --dashboard-host localhost --dashboard-port 8050 --mqtt --mqtt-host localhost --mqtt-port 1883 --csv --export-config --path /data
Restart=always
RestartSec=60s

[Install]
WantedBy=multi-user.target

