[Unit]
Description=Detect signals of wildlife tracking transmitters with RTL SDR devices
After=network.target mosquitto.service time-sync.target hostname-config.service
Requires=time-sync.target
RequiresMountsFor=/boot/firmware /data
ConditionPathExists=/boot/firmware/radiotracking.ini

# Reboot after more than 10 restarts in 15 minutes happened.
# This will happen after 10 minutes at the earliest, according to service configuration.
StartLimitBurst=10
StartLimitIntervalSec=900s
StartLimitAction=reboot

[Service]
Type=exec
# Runs as pi with a sandbox like the other tsOS-base daemons (see tsOS-base docs/security.md).
User=pi
Group=pi
Nice=-10
ExecStart=/usr/local/bin/radiotracking --config /boot/firmware/radiotracking.ini --station %H --mqtt --mqtt-host localhost --mqtt-port 1883 --csv --export-config --path /data
Restart=always
RestartSec=60s
ReadWritePaths=/data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# AF_NETLINK: libusb enumerates USB devices through a netlink socket (without it: "No supported devices found")
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# RTL-SDR dongles are raw USB devices (/dev/bus/usb, mode 0666 via librtlsdr's rtl-sdr.rules)
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
