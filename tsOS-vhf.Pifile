FROM "https://github.com/trackIT-Systems/tsOS-base/releases/download/2027.0.6/tsOS-base-arm64-2027.0.6.zip"
TO "tsOS-vhf-arm64.img"
PUMP 500M

# Set os-release info
NAME="tsOS"
VARIANT="VHF"
VERSION_CODENAME="Barbastella"
VERSION_ID=`git describe --tags --always || true`
VERSION_COMMIT=`git rev-parse --verify HEAD`

RUN tee /etc/os-release <<EOF
PRETTY_NAME="$NAME $VARIANT $VERSION_ID ($VERSION_CODENAME)"
NAME=$NAME
ID="${NAME,,}"
ID_LIKE=debian
VARIANT=$VARIANT
VARIANT_ID=${VARIANT,,}
VERSION_ID=$VERSION_ID
VERSION="$VERSION_ID ($VERSION_CODENAME)"
VERSION_COMMIT=$VERSION_COMMIT
VERSION_CODENAME=$VERSION_CODENAME
HOME_URL="https://trackit.systems/"
SUPPORT_URL="https://github.com/trackIT-Systems/tsOS-vhf"
BUG_REPORT_URL="https://github.com/trackIT-Systems/tsOS-vhf/issues"
EOF

# write build process entry
RUN tee -a /boot/firmware/issue.txt <<EOF
Modified using pimod, https://github.com/trackIT-Systems/tsOS-vhf, $VERSION_COMMIT, $VERSION_ID
EOF

# Install custom folders 
INSTALL boot /boot
INSTALL etc /etc
INSTALL usr /usr

RUN rm /usr/local/src/pyradiotracking/.git
INSTALL .git/modules/usr/local/src/pyradiotracking /usr/local/src/pyradiotracking/.git
RUN rm /usr/local/src/pyrtlsdr/.git
INSTALL .git/modules/usr/local/src/pyrtlsdr /usr/local/src/pyrtlsdr/.git

# Source trees are root-owned, like in tsOS-base
RUN chown -R root:root /usr/local/src
RUN chmod -R go-w /usr/local/src
RUN sh -c 'for d in /usr/local/src/*/; do git config --system --add safe.directory "${d%/}"; done'

# root's password is a build-time secret via TSOS_ROOT_PASSWORD, never
# committed here.
# Setting one also enables password SSH for root, which is key-only otherwise.
# If unset, nothing is changed, so the root password of the base image survives.
# The salt is fixed (16 chars, [A-Za-z0-9./]) so the same password gives the same hash.
RUN sh -c 'if [ -n "$TSOS_ROOT_PASSWORD" ]; then \
        echo "root:$(echo "$TSOS_ROOT_PASSWORD" | openssl passwd -6 -salt tsOSrootsalt0000 -stdin)" | chpasswd -e; \
        sed -i "s/^PermitRootLogin .*/PermitRootLogin yes/" /etc/ssh/sshd_config.d/10-tsos.conf; \
    fi'

#################################################
### services configuration

# Install librtlsdr (library, udev rules and tools) from the release packages.
LIBRTLSDR_VERSION="0.9.1"

# apt pulls in the libusb runtime library; no build toolchain is needed.
RUN mkdir -p /var/cache/apt/archives/partial
RUN apt update

RUN curl -fsSL --retry 3 -o /tmp/librtlsdr0.deb "https://github.com/trackIT-Systems/librtlsdr/releases/download/v${LIBRTLSDR_VERSION}/librtlsdr0_${LIBRTLSDR_VERSION}_arm64.deb"
RUN curl -fsSL --retry 3 -o /tmp/rtl-sdr.deb "https://github.com/trackIT-Systems/librtlsdr/releases/download/v${LIBRTLSDR_VERSION}/rtl-sdr_${LIBRTLSDR_VERSION}_arm64.deb"
RUN apt-get install -y /tmp/librtlsdr0.deb /tmp/rtl-sdr.deb
RUN rm -f /tmp/librtlsdr0.deb /tmp/rtl-sdr.deb

RUN apt-get install -y \
    python3-setuptools \
    python3-numpy \
    python3-scipy \
    python3-schedule

ENV PIP_ROOT_USER_ACTION ignore
ENV PIP_BREAK_SYSTEM_PACKAGES 1

RUN python3 -m pip install --no-deps -e /usr/local/src/pyrtlsdr

# Install radiotracking
RUN python3 -m pip install --no-deps -e /usr/local/src/pyradiotracking
RUN systemctl enable radiotracking.service

#################################################
### Cleanup image
RUN rm -rf /var/lib/apt/lists/
RUN apt-get clean
WORKDIR /usr/local/src
RUN rm -rf /root/.cache/pip
RUN find . -name "*.pyc" -exec rm -f {} \;

ZERO
SHRINK
