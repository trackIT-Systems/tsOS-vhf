FROM "https://github.com/trackIT-Systems/tsOS-base/releases/download/2027.0.3/tsOS-base-arm64-2027.0.3.zip"
TO "tsOS-vhf-arm64.img"
PUMP 500M

# Set os-release info
NAME="tsOS"
VARIANT="VHF"
VERSION_CODENAME="Barbastella"

VERSION_ID=`git describe --tags --always || true`
VERSION_COMMIT=`git rev-parse --verify HEAD`

RUN tee /etc/os-release <<EOF
PRETTY_NAME="$NAME $VARIANT $VERSION_ID ($VERSION_CODENAME)"
NAME=$NAME
ID="${NAME,,}"
ID_LIKE=debian
VARIANT=$VARIANT
VARIANT_ID=${VARIANT,,}
VERSION_ID=$VERSION_ID
VERSION="$VERSION_ID ($VERSION_CODENAME)"
VERSION_COMMIT=$VERSION_COMMIT
VERSION_CODENAME=$VERSION_CODENAME
HOME_URL="https://trackit.systems/"
SUPPORT_URL="https://github.com/trackIT-Systems/tsOS-vhf"
BUG_REPORT_URL="https://github.com/trackIT-Systems/tsOS-vhf/issues"
EOF

# write build process entry
RUN tee -a /boot/firmware/issue.txt <<EOF
Modified using pimod, https://github.com/trackIT-Systems/tsOS-vhf, $VERSION_COMMIT, $VERSION_ID
EOF

# Install custom folders 
INSTALL boot /boot
INSTALL etc /etc
INSTALL usr /usr

RUN rm /usr/local/src/librtlsdr/.git
INSTALL .git/modules/usr/local/src/librtlsdr /usr/local/src/librtlsdr/.git
RUN rm /usr/local/src/pyradiotracking/.git
INSTALL .git/modules/usr/local/src/pyradiotracking /usr/local/src/pyradiotracking/.git
RUN rm /usr/local/src/pyrtlsdr/.git
INSTALL .git/modules/usr/local/src/pyrtlsdr /usr/local/src/pyrtlsdr/.git

# Source trees are root-owned, like in tsOS-base
RUN chown -R root:root /usr/local/src
RUN chmod -R go-w /usr/local/src
RUN sh -c 'for d in /usr/local/src/*/; do git config --system --add safe.directory "${d%/}"; done'

#################################################
### services configuration

# Install rtlsdr build dependencies
RUN mkdir -p /var/cache/apt/archives/partial
RUN apt update
RUN apt-get install -y build-essential cmake libusb-1.0-0-dev

WORKDIR /usr/local/src/librtlsdr
RUN cmake . -DINSTALL_UDEV_RULES=ON
RUN make -j4
RUN make install
RUN ldconfig

# Remove the build toolchain again, keep the libusb runtime library
RUN git -C /usr/local/src/librtlsdr clean -fdx
RUN apt-mark manual libusb-1.0-0
RUN apt-get purge -y --auto-remove build-essential cmake libusb-1.0-0-dev

RUN apt-get install -y \
    python3-setuptools \
    python3-numpy \
    python3-scipy \
    python3-schedule

ENV PIP_ROOT_USER_ACTION ignore
ENV PIP_BREAK_SYSTEM_PACKAGES 1

RUN python3 -m pip install --no-deps -e /usr/local/src/pyrtlsdr

# Install radiotracking
RUN python3 -m pip install --no-deps -e /usr/local/src/pyradiotracking
RUN systemctl enable radiotracking.service

#################################################
### Cleanup image
RUN rm -rf /var/lib/apt/lists/
RUN apt-get clean
RUN rm -rf /root/.cache/pip
RUN find . -name "*.pyc" -exec rm -f {} \;

ZERO
SHRINK
